# =============================================================================
# VibeU - Variáveis de ambiente
# Copie este arquivo para .env e ajuste os valores:
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL ---
POSTGRES_DB=vibeu
POSTGRES_USER=vibeu
POSTGRES_PASSWORD=dev_password_change_me
POSTGRES_PORT=5432

# --- pgAdmin (interface web do PostgreSQL) ---
PGADMIN_EMAIL=admin@vibeu.dev
PGADMIN_PASSWORD=admin_password_change_me
PGADMIN_PORT=5050

# --- Backend (Spring Boot) ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JDBC - apenas para dev local (apps fora do Docker).
# No Docker Compose, a URL é sobrescrita para postgres:5432 automaticamente.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vibeu
SPRING_DATASOURCE_USERNAME=vibeu
SPRING_DATASOURCE_PASSWORD=dev_password_change_me

# Segurança
JWT_SECRET=change_me_to_a_random_string_with_at_least_32_characters

# --- Frontend ---
# Porta exposta pelo container Nginx no Docker Compose (Vite em dev usa 5173 fixo)
FRONTEND_PORT=80
# Dev com Vite (proxy em vite.config.ts): deixe vazio
# Dev sem proxy / Docker build: http://localhost:8080
VITE_API_URL=

# --- Produção (ajuste antes do deploy) ---
# VITE_API_URL=http://seu-dominio.com/api
